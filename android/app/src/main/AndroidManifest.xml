<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Capture talks to one host over HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- android.permission.USE_BIOMETRIC is merged in automatically by
         androidx.biometric, not declared here. It gates opening the app
         behind the phone's own screen lock (design/android-unlock-plan.md)
         and grants nothing beyond what BiometricPrompt itself needs. Named
         here so a later reader finds the reason rather than just the
         merged manifest. -->

    <application
        android:label="Clarice Capture"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClariceCapture"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/backup_rules_legacy">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share to capture. text/plain only: a shared link arrives as
                 text and is kept as text, and there is nothing sensible this
                 app could do with an image. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
