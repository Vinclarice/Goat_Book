<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ backup rules.

  The encrypted token is excluded from every transfer mode. Not because the
  ciphertext is dangerous to copy (the Keystore key never leaves the device,
  so a backup carries something no other device can read) but because
  restoring it is a correctness problem: the new device would hold
  ciphertext with no key, and decryption would fail where "not connected
  yet" is the honest state.

  The pending-capture queue is excluded for exactly the same reason, and was
  not, until August 13, 2026. It holds unsent thoughts under its own Keystore
  alias, so a restored device would read ciphertext it has no key for. The
  queue treats an unreadable store as an empty one, which is right when a key
  is genuinely gone and catastrophic here: every thought written down and not
  yet delivered would disappear on a phone upgrade, silently, with no error
  and nothing to retry. The reasoning above had been worked out for the token
  and simply never extended to the thing the app exists to protect.

  Every mode is listed on purpose. Omitting a section leaves that transfer
  path fully enabled, so silence here means the opposite of caution.

  Note for anyone editing: XML comments may not contain a double hyphen, so
  this file cannot use the dashes the rest of the codebase writes with.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="clarice_capture_secret.xml" />
        <exclude domain="sharedpref" path="second_mind_capture_secret.xml" />
        <exclude domain="sharedpref" path="clarice_capture_queue_store.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="clarice_capture_secret.xml" />
        <exclude domain="sharedpref" path="second_mind_capture_secret.xml" />
        <exclude domain="sharedpref" path="clarice_capture_queue_store.xml" />
    </device-transfer>
</data-extraction-rules>
