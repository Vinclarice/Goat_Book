            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DayOut"
                }
              }
            }
          }
        },
        "description": "Write into the requesting user's day.\n\nThere is no ownership check to forget: the entry is addressed by\n(request.user, day), so the path names a date and never a record. One\nperson cannot reach another's day through this endpoint at all, which\nis a smaller surface than an id would be.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
