                "schema": {
                  "$ref": "#/components/schemas/TimeZonesOut"
                }
              }
            }
          }
        },
        "description": "The zones the picker may offer.\n\nServed rather than read from the browser's own Intl list: the two can\ndisagree, and a disagreement would show up as a validation error on a\nzone this application had just offered the person.",
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
