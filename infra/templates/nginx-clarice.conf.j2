# Managed by Ansible (infra/deploy-playbook.yaml).
# Certbot obtains certificates but never edits this file.

# First line of defense against brute-forcing login/signup: throttle by
# client IP before the request even reaches Django. django-axes (see
# clarice/settings.py) is the second line, locking out an *account*
# after repeated failures regardless of which IP they come from.
limit_req_zone $binary_remote_addr zone=clarice_auth:10m rate=5r/m;

# The contact form is the one page a stranger can POST to, so it gets the
# same two-layer treatment. This throttles *requests*; accounts.views.contact
# separately caps how many messages actually leave per hour. Different jobs:
# this stops a flood, that stops a patient script sending five valid
# messages and waiting.
limit_req_zone $binary_remote_addr zone=clarice_contact:10m rate=10r/m;

# Reject unknown hostnames before they reach Django. The TLS catch-all rejects
# the handshake without needing to present a certificate for an unknown name.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 80;
    server_name {{ site_domain }}{% if include_www_alias | bool %} www.{{ site_domain }}{% endif %};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name {{ site_domain }}{% if include_www_alias | bool %} www.{{ site_domain }}{% endif %};

    ssl_certificate /etc/letsencrypt/live/{{ site_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ site_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    location ~ ^/(accounts/login|accounts/signup)/ {
        limit_req zone=clarice_auth burst=3 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # X-Real-IP is load-bearing here rather than informational: the view
    # keys its per-visitor send limit on it, because REMOTE_ADDR is this
    # proxy for everyone. nginx overwrites any client-supplied value, which
    # is what makes it trustworthy.
    location = /contact/ {
        limit_req zone=clarice_contact burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
