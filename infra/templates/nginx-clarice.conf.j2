# Managed by Ansible (infra/deploy-playbook.yaml).
# Certbot obtains certificates but never edits this file.

# First line of defense against brute-forcing login/signup: throttle by
# client IP before the request even reaches Django. django-axes (see
# clarice/settings.py) is the second line, locking out an *account*
# after repeated failures regardless of which IP they come from.
limit_req_zone $binary_remote_addr zone=clarice_auth:10m rate=5r/m;

# The two places a stranger can make the server send mail: the contact form
# and the password reset. This throttles *requests*, and on this deployment it
# is the throughput bound that actually holds.
#
# It used to say that accounts.views.contact "separately caps how many messages
# actually leave per hour". That is not true here and the correction is the
# point of this comment. The view's counter lives in Django's default cache,
# which is LocMemCache -- a dict in one process -- and the Dockerfile runs one
# gunicorn worker with --max-requests 500 --max-requests-jitter 50. A recycled
# worker starts at zero. Worse, nothing in this file serves /static/, so
# whitenoise answers every CSS, JS and font request through gunicorn and
# ordinary browsing spends that budget: the counter resets on its own, with
# nobody attacking anything.
#
# So the view's cap is "up to five per worker lifetime", not per hour, and what
# bounds a patient script is this zone plus the form's honeypot. Making the
# hourly claim true needs a cache shared between processes, which is
# infrastructure this deployment does not have and a decision nobody has taken.
#
# The reset has no second cap at all, which is the argument for it sharing this
# zone rather than sitting behind nothing -- it sends its mail synchronously,
# on the request thread.
limit_req_zone $binary_remote_addr zone=clarice_contact:10m rate=10r/m;

# POST /api/v1/login trades a password for a 90-day, all-scopes bearer
# token, and is `auth=None` by design -- the only operation on /api/v1/ a
# stranger can call. It matched nothing but the catch-all until now, while
# this file's own header claimed nginx was the first line of defense for
# exactly this, and settings.py said the same. Both were false for the one
# route where it mattered most. architecture-trajectory.md 6 records closing
# this same hole for /; the API login shipped three days later without a
# matching rule.
#
# Its own budget rather than clarice_auth's, following the landing rule
# below: a phone connecting is not competing with a browser at
# /accounts/login/, and behind home NAT the two share an address. Five a
# minute is generous for an endpoint the client calls once per connection.
#
# Not keyed on method: unlike /, this path has no GET worth serving -- a
# GET returns 405, so throttling every method costs nothing real.
limit_req_zone $binary_remote_addr zone=clarice_api_login:10m rate=5r/m;

# The landing page is also a login form: accounts.views.LandingLoginView is a
# LoginView, so POST / authenticates exactly as POST /accounts/login/ does.
# The auth zone above therefore had a hole in it -- the strictest control on
# the site was bypassed by the front door. See design/architecture-trajectory.md
# 6, which carried this as an outstanding item.
#
# Keyed on the request method rather than on the address alone, because / is
# unlike /accounts/login/ in one way that matters: it is the public front
# door. Throttling its GETs would trade a real availability risk -- a visitor
# reloading the homepage, or being shown it -- for no security gain, since a
# GET returns a form rather than attempting a login. An empty key disables
# the limit for that request, which is nginx's documented idiom for
# conditional rate limiting.
#
# This is a second budget rather than a shared one, so a single IP can spend
# 5r/m here and 5r/m at /accounts/login/. Deliberate: django-axes locks the
# *account* after five failures regardless of source, so the difference
# between five and ten attempts a minute from one address is not the control
# that matters, and unifying the budget would mean changing the existing
# rule's semantics as a side effect of closing a different hole.
map $request_method $landing_login_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $landing_login_key zone=clarice_landing:10m rate=5r/m;

# The access log records the path and not the query, because on this site the
# query *is* the private material. /mind/share/ is the PWA share target and is
# declared "method": "GET", so a shared passage arrives as ?text=...;
# /mind/search/ takes ?q=... . Both are somebody's own words.
#
# Nothing here set access_log before, so the distro default applied: the
# built-in `combined` format, whose "$request" is the verbatim request line.
# Every search and every share was therefore written to a plaintext disk log on
# every request -- not on error, on every request -- and kept for as long as
# rotation keeps it.
#
# $uri rather than $request or $request_uri: it is the path after normalisation
# and carries no query string. Method and protocol are restored either side of
# it so the line stays the same shape, and every other field of `combined` is
# unchanged -- this drops one thing and keeps the log's operational value.
log_format clarice_no_query
    '$remote_addr - $remote_user [$time_local] '
    '"$request_method $uri $server_protocol" $status $body_bytes_sent '
    '"$http_referer" "$http_user_agent"';

# Reject unknown hostnames before they reach Django. The TLS catch-all rejects
# the handshake without needing to present a certificate for an unknown name.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 80;
    server_name {{ site_domain }}{% if include_www_alias | bool %} www.{{ site_domain }}{% endif %};

    # This block only redirects, and `return 301 https://$host$request_uri`
    # carries the query with it -- so without this the redirect hop logs
    # exactly what the https hop would have.
    access_log /var/log/nginx/access.log clarice_no_query;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name {{ site_domain }}{% if include_www_alias | bool %} www.{{ site_domain }}{% endif %};

    access_log /var/log/nginx/access.log clarice_no_query;

    ssl_certificate /etc/letsencrypt/live/{{ site_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ site_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    location ~ ^/(accounts/login|accounts/signup)/ {
        limit_req zone=clarice_auth burst=3 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # X-Real-IP is load-bearing here rather than informational: the view
    # keys its per-visitor send limit on it, because REMOTE_ADDR is this
    # proxy for everyone. nginx overwrites any client-supplied value, which
    # is what makes it trustworthy.
    location = /contact/ {
        limit_req zone=clarice_contact burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Exact match and no trailing slash: the Ninja route is /api/v1/login and
    # that is the literal path ClariceApi.kt posts to. An exact match also
    # cannot be shadowed by a later prefix or regex block, which is what
    # makes this safe to leave alone.
    location = /api/v1/login {
        limit_req zone=clarice_api_login burst=3 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Reachable without an account and sends its mail on the request thread,
    # so a flood costs worker time as well as messages. Same shape as the
    # login hole above, lower severity -- recorded in the review that found
    # that one and closed with it.
    location = /accounts/password/reset/ {
        limit_req zone=clarice_contact burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Exact match, so only the landing page itself is covered and every other
    # path still falls through to the catch-all below.
    location = / {
        limit_req zone=clarice_landing burst=3 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
